# -------------------------------------------------------
# NYC Reservation Times — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.
# -------------------------------------------------------

# Anthropic API key — used by scrapers to parse ambiguous
# booking pages and infer release patterns.
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Secret key that protects the POST /update endpoint.
# Choose any long random string (e.g. openssl rand -hex 32).
UPDATE_API_KEY=your_update_api_key_here
